#!/bin/bash
set -euo pipefail

PROJECT="intrepid-period-461115-b6"
SERVICE="observability-bridge"
REGION="us-east1"
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

echo "=== Desplegando $SERVICE en Cloud Run ==="

gcloud config set project "$PROJECT" --quiet

gcloud run deploy "$SERVICE" \
  --source . \
  --region="$REGION" \
  --memory=256Mi \
  --cpu=1 \
  --min-instances=0 \
  --max-instances=1 \
  --concurrency=80 \
  --allow-unauthenticated \
  --set-env-vars="DATABASE_URL=$DATABASE_URL"

echo "=== URL: https://$SERVICE-278833805240.$REGION.run.app ==="
