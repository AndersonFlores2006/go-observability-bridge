# Ejemplo de variables de entorno
# Copiar a .env y configurar valores reales

# Puerto del servidor HTTP
PORT=8080

# Base de datos PostgreSQL
# Neon: postgresql://user:pass@host.neon.tech/db?sslmode=require
# Local: postgresql://admin:admin123@localhost:5432/observability?sslmode=disable
DATABASE_URL=postgresql://admin:admin123@localhost:5432/observability?sslmode=disable

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# Webhook para alertas (opcional)
WEBHOOK_URL=
